{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "heart-prometheus",
        "namespace": "heart-mlops"
      },
      "data": {
        "prometheus.yml": "global:\n  scrape_interval: 5s\nscrape_configs:\n  - job_name: heart-api\n    static_configs:\n      - targets: [\"heart-api:80\"]\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "heart-grafana-provisioning",
        "namespace": "heart-mlops"
      },
      "data": {
        "datasources.yaml": "apiVersion: 1\ndatasources:\n  - name: Prometheus\n    uid: prometheus\n    type: prometheus\n    access: proxy\n    url: http://prometheus:9090\n    isDefault: true\n",
        "dashboards.yaml": "apiVersion: 1\nproviders:\n  - name: Heart API\n    type: file\n    options:\n      path: /var/lib/grafana/dashboards\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "heart-grafana-dashboard",
        "namespace": "heart-mlops"
      },
      "data": {
        "heart.json": "{\n  \"title\": \"Heart API Operations\",\n  \"uid\": \"heart-api\",\n  \"schemaVersion\": 39,\n  \"version\": 1,\n  \"refresh\": \"5s\",\n  \"time\": {\n    \"from\": \"now-15m\",\n    \"to\": \"now\"\n  },\n  \"panels\": [\n    {\n      \"id\": 1,\n      \"title\": \"Request rate by status\",\n      \"type\": \"timeseries\",\n      \"gridPos\": {\n        \"h\": 9,\n        \"w\": 12,\n        \"x\": 0,\n        \"y\": 0\n      },\n      \"datasource\": {\n        \"type\": \"prometheus\",\n        \"uid\": \"prometheus\"\n      },\n      \"targets\": [\n        {\n          \"expr\": \"sum by (status) (rate(heart_api_requests_total{route=\\\"/predict\\\"}[1m]))\",\n          \"refId\": \"A\"\n        }\n      ]\n    },\n    {\n      \"id\": 2,\n      \"title\": \"5xx error rate\",\n      \"type\": \"timeseries\",\n      \"gridPos\": {\n        \"h\": 9,\n        \"w\": 12,\n        \"x\": 12,\n        \"y\": 0\n      },\n      \"datasource\": {\n        \"type\": \"prometheus\",\n        \"uid\": \"prometheus\"\n      },\n      \"targets\": [\n        {\n          \"expr\": \"sum(rate(heart_api_requests_total{status=~\\\"5..\\\"}[1m])) or vector(0)\",\n          \"refId\": \"A\"\n        }\n      ]\n    },\n    {\n      \"id\": 3,\n      \"title\": \"p95 request latency\",\n      \"type\": \"timeseries\",\n      \"gridPos\": {\n        \"h\": 9,\n        \"w\": 12,\n        \"x\": 0,\n        \"y\": 9\n      },\n      \"datasource\": {\n        \"type\": \"prometheus\",\n        \"uid\": \"prometheus\"\n      },\n      \"targets\": [\n        {\n          \"expr\": \"histogram_quantile(0.95, sum by (le) (rate(heart_api_request_duration_seconds_bucket{route=\\\"/predict\\\"}[1m])))\",\n          \"refId\": \"A\"\n        }\n      ]\n    },\n    {\n      \"id\": 4,\n      \"title\": \"Total prediction requests\",\n      \"type\": \"timeseries\",\n      \"gridPos\": {\n        \"h\": 9,\n        \"w\": 12,\n        \"x\": 12,\n        \"y\": 9\n      },\n      \"datasource\": {\n        \"type\": \"prometheus\",\n        \"uid\": \"prometheus\"\n      },\n      \"targets\": [\n        {\n          \"expr\": \"sum(heart_api_requests_total{route=\\\"/predict\\\"})\",\n          \"refId\": \"A\"\n        }\n      ]\n    }\n  ]\n}"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "prometheus",
        "namespace": "heart-mlops"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "heart-prometheus"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "heart-prometheus"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "prometheus",
                "image": "prom/prometheus:v3.2.1",
                "ports": [
                  {
                    "containerPort": 9090
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/prometheus"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/-/ready",
                    "port": 9090
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "heart-prometheus"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "prometheus",
        "namespace": "heart-mlops"
      },
      "spec": {
        "selector": {
          "app": "heart-prometheus"
        },
        "ports": [
          {
            "port": 9090,
            "targetPort": 9090
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "grafana",
        "namespace": "heart-mlops"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "heart-grafana"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "heart-grafana"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "grafana",
                "image": "grafana/grafana:11.6.0",
                "ports": [
                  {
                    "containerPort": 3000
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "provisioning",
                    "mountPath": "/etc/grafana/provisioning"
                  },
                  {
                    "name": "dashboard",
                    "mountPath": "/var/lib/grafana/dashboards"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/api/health",
                    "port": 3000
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 5
                },
                "env": [
                  {
                    "name": "GF_AUTH_ANONYMOUS_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "GF_AUTH_ANONYMOUS_ORG_ROLE",
                    "value": "Viewer"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "provisioning",
                "configMap": {
                  "name": "heart-grafana-provisioning",
                  "items": [
                    {
                      "key": "datasources.yaml",
                      "path": "datasources/prometheus.yaml"
                    },
                    {
                      "key": "dashboards.yaml",
                      "path": "dashboards/heart.yaml"
                    }
                  ]
                }
              },
              {
                "name": "dashboard",
                "configMap": {
                  "name": "heart-grafana-dashboard"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "grafana",
        "namespace": "heart-mlops"
      },
      "spec": {
        "selector": {
          "app": "heart-grafana"
        },
        "ports": [
          {
            "port": 3000,
            "targetPort": 3000
          }
        ]
      }
    }
  ]
}
